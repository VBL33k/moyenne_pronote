{
  "manifest_version": 3,
  "name": "Calculatrice de Moyenne Pronote",
  "version": "1.1",
  "description": "Calcule automatiquement votre moyenne générale sur Pronote",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.pronote.fr/*",
    "*://*.index-education.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.pronote.fr/*",
        "*://*.index-education.net/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Calculatrice de Moyenne Pronote"
  }
}
